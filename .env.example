# Copy this file to .env and replace every placeholder with fresh values.
DB_USERNAME=postgres
DB_PASSWORD=replace_with_a_new_strong_database_password
DB_URL=jdbc:postgresql://localhost:5432/dreamsync
JWT_SECRET=replace_with_a_new_random_signing_secret_at_least_32_bytes_long
JWT_EXPIRATION=86400000

# Add your deployed frontend origin when deploying
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Use validate in production after applying database migrations
DDL_AUTO=update
